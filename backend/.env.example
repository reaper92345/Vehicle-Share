NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/equipshare
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
# Set to true when connecting to a PostgreSQL server that requires SSL.
PGSSL=false
# Comma-separated exact frontend origins. Configure each frontend origin explicitly.
CORS_ORIGINS=http://localhost:3000
